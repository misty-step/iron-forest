# iron-forest piranha tank — systemd --user unit.
# The factory runs on this machine, pulls green master itself, and swaps to a
# fresh build at a pass boundary (self-exec; same PID, so no restart ever
# interrupts an in-flight agent). See deploy/install-service.sh.
#
# @REPO_DIR@ is a placeholder: deploy/install-service.sh substitutes the
# absolute path of the repository it installs from, so a clone moved elsewhere
# still deploys correctly.

[Unit]
Description=iron-forest piranha tank (self-updating factory daemon)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/forest chew
Restart=always
RestartSec=10
# Agents run without a deadline, so a draining pass gets unlimited room to
# finish the in-flight agent. systemd must never SIGKILL a live agent: that
# abandons a worktree and wastes every token the run already spent. The escape
# hatch is a second SIGTERM, which the daemon turns into an immediate exit.
TimeoutStopSec=infinity
# mise shims so the daemon can rebuild itself with the pinned toolchain.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
