# iron-forest systemd --user unit.
# The daemon runs on this machine and updates itself at pass boundaries.
# @REPO_DIR@ is replaced with the installing repository path.

[Unit]
Description=iron-forest factory daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/forest serve
Restart=always
RestartSec=10
# A draining pass must finish its in-flight agent before systemd stops it.
TimeoutStopSec=infinity
# mise shims keep the pinned toolchain available to self-update.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
