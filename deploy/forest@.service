# iron-forest systemd --user template unit.
#
# One instance runs one managed checkout: `systemctl --user start forest@<name>`.
# @FOREST_ROOT@ is replaced by deploy/install-service.sh.

[Unit]
Description=Iron Forest Kernel for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@FOREST_ROOT@/%i
# Required per-instance credentials and other private service environment.
EnvironmentFile=%h/.config/iron-forest/%i.env
PrivateTmp=yes
ExecStartPre=@FOREST_ROOT@/%i/forest selfcheck
ExecStart=@FOREST_ROOT@/%i/forest serve
Restart=always
RestartSec=10
# Signal only the Kernel first; systemd may kill the cgroup after the drain bound.
KillMode=mixed
# 3900 seconds covers concurrent declared Runs, Runner cleanup, and serialized audits.
TimeoutStopSec=3900
# The mise shim directory is included because Pi is version managed and absent
# from the base directories. Selfcheck fails before ExecStart when a host cannot
# dispatch.
Environment=PATH=%h/.local/bin:%h/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=FOREST_DEFAULTS

[Install]
WantedBy=default.target
