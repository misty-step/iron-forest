# iron-forest systemd --user template unit.
#
# One instance per managed checkout: `systemctl --user start forest@<name>`,
# where <name> is a sibling directory of the factory source. One organization
# runs one installation, and the organization's checkout directory is its root.
#
# Instances share the factory source and nothing else: separate process, config,
# refs, worktrees and ledger. A stuck agent in one repository cannot stall
# another, which is why this needs no supervisor and no central policy.
#
# @FOREST_ROOT@ and @FACTORY_DIR@ are replaced by deploy/install-service.sh.

[Unit]
Description=iron-forest factory daemon for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@FOREST_ROOT@/%i
ExecStart=@FOREST_ROOT@/%i/forest serve --factory-dir @FACTORY_DIR@
Restart=always
RestartSec=10
# A draining pass must finish its in-flight agent before systemd stops it.
TimeoutStopSec=infinity
# mise shims keep the pinned toolchain available to self-update.
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
