#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

REAL_GIT = "/usr/bin/git"
RACE = Path("/eval/race.json")
TRIGGERED = Path("/eval/race-triggered")

args = sys.argv[1:]
if RACE.is_file() and not TRIGGERED.exists() and "push" in args and "--atomic" in args:
    completed = subprocess.run(
        ["python3", "/opt/iron-forest-eval/race.py", os.getcwd(), json.dumps(args)],
        check=False,
    )
    if completed.returncode != 0:
        raise SystemExit(completed.returncode)
os.execv(REAL_GIT, [REAL_GIT, *args])
