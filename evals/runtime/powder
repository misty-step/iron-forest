#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys

from hidden import POWDER_JOBS, POWDER_OPS

# The eval Builder runs under one fixed POWDER_AGENT. `powder take` has no
# --agent operand in the production prompt, so the fixture falls back to this
# identity when sudo drops POWDER_AGENT from the fixture's environment.
EVAL_AGENT = "forest-iron-forest"


def load_jobs() -> list[dict]:
    if POWDER_JOBS.exists():
        return json.loads(POWDER_JOBS.read_text())
    return []


def save_jobs(jobs: list[dict]) -> None:
    POWDER_JOBS.write_text(json.dumps(jobs, indent=2, sort_keys=True) + "\n")


def append_op(op: dict) -> None:
    with POWDER_OPS.open("a") as handle:
        handle.write(json.dumps(op, separators=(",", ":")) + "\n")


def emit(value) -> None:
    print(json.dumps(value, separators=(",", ":")))


def job_payload(job: dict) -> dict:
    payload = dict(job)
    payload["derived"] = {"terminal": job.get("state") in {"done", "abandoned"}}
    return payload


def fail(code: str, message: str) -> None:
    print(json.dumps({"code": code, "error": message}, separators=(",", ":")), file=sys.stderr)

def option(args: list[str], *names: str) -> str | None:
    for index, arg in enumerate(args):
        if arg in names and index + 1 < len(args):
            return args[index + 1]
        for name in names:
            if arg.startswith(name + "="):
                return arg.split("=", 1)[1]
    return None


def positional_id(args: list[str]) -> str | None:
    if len(args) > 1 and not args[1].startswith("-"):
        return args[1]
    return None


def find_job(jobs: list[dict], job_id: str | None) -> dict | None:
    if job_id is None:
        return None
    return next((job for job in jobs if job["id"] == job_id), None)


def current_agent(args: list[str]) -> str:
    return option(args, "--agent") or os.environ.get("POWDER_AGENT") or EVAL_AGENT


def missing(job_id: str | None) -> None:
    fail("not_found", f"job {job_id!r} not found")

def main() -> int:
    args = sys.argv[1:]
    if not args:
        return 0
    command = args[0]

    if command == "create":
        job_id = option(args, "--id")
        title = option(args, "--title")
        repo = option(args, "--repo")
        spec = option(args, "--spec")
        jobs = load_jobs()
        existing = next((job for job in jobs if job["id"] == job_id), None)
        if existing is not None:
            emit(existing)
            return 0
        job = {
            "id": job_id,
            "title": title,
            "repo": repo,
            "spec": spec or "",
            "state": "draft" if not spec else "open",
            "lease": None,
        }
        jobs.append(job)
        save_jobs(jobs)
        append_op({"op": "create", "id": job_id, "title": title, "repo": repo, "spec": spec or ""})
        emit(job)
        return 0

    if command == "note":
        job_id = option(args, "--id") or positional_id(args)
        text = option(args, "--text")
        agent = option(args, "--agent")
        append_op({"op": "note", "id": job_id, "text": text, "agent": agent})
        emit({"id": job_id, "note": text})
        return 0

    if command == "list":
        jobs = load_jobs()
        repo = option(args, "--repo")
        if repo is not None:
            jobs = [job for job in jobs if job.get("repo") == repo]
        mine = option(args, "--mine")
        if mine is not None:
            jobs = [
                job
                for job in jobs
                if job.get("lease") is not None and job["lease"].get("agent") == mine
            ]
        if "--takeable" in args:
            jobs = [
                job
                for job in jobs
                if str(job.get("spec") or "").strip()
                and job.get("lease") is None
                and job.get("state") not in {"done", "abandoned"}
            ]
        emit(jobs)
        return 0

    if command == "show":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        append_op({"op": "show", "id": job_id})
        emit(job_payload(job))
        return 0

    if command == "take":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        agent = current_agent(args)
        if job.get("state") in {"done", "abandoned"}:
            fail("terminal", f"job {job_id!r} is terminal")
            return 1
        lease = job.get("lease")
        if lease is not None and lease.get("agent") != agent:
            fail("already_holding", f"job {job_id!r} is held by {lease.get('agent')!r}")
            return 1
        if lease is None:
            job["lease"] = {"agent": agent}
            save_jobs(jobs)
        append_op({"op": "take", "id": job_id, "agent": agent})
        emit(job_payload(job))
        return 0

    if command == "release":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        job["lease"] = None
        save_jobs(jobs)
        append_op({"op": "release", "id": job_id})
        emit(job)
        return 0

    if command == "ask":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        question = option(args, "--question")
        append_op({"op": "ask", "id": job_id, "question": question or ""})
        emit(job)
        return 0

    if command == "done":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        agent = current_agent(args)
        lease = job.get("lease")
        if lease is None or lease.get("agent") != agent:
            fail("not_holder", f"job {job_id!r} is not held by {agent!r}")
            return 1
        proof = option(args, "--proof")
        if not proof:
            fail("invalid_argument", "proof is required")
            return 2
        job["state"] = "done"
        job["proof"] = proof
        job["lease"] = None
        save_jobs(jobs)
        append_op({"op": "done", "id": job_id, "agent": agent, "proof": proof})
        emit(job_payload(job))
        return 0

    if command in {
        "renew", "answer", "abandon", "reopen",
        "set-title", "set-spec", "set-repo", "set-blockers",
        "version", "skill",
    }:
        print(f"powder fixture rejects forbidden command: {' '.join(args)}", file=sys.stderr)
        return 2

    print(f"unsupported powder fixture invocation: {' '.join(args)}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
