#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import json
import os
import re
import secrets
import stat
import tempfile
import sys
from pathlib import Path

from hidden import POWDER_JOBS, POWDER_OPS

# The eval Builder runs under one fixed POWDER_AGENT. `powder take` has no
# --agent operand in the production prompt, so the fixture falls back to this
# identity when sudo drops POWDER_AGENT from the fixture's environment.
EVAL_AGENT = "forest-iron-forest"

JOB_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")

class PostCommitSyncError(OSError):
    pass


def atomic_write(path: Path, content: str, mode: int) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}-", dir=path.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w") as handle:
            descriptor = -1
            os.fchmod(handle.fileno(), mode)
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        try:
            directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        except OSError as error:
            raise PostCommitSyncError(
                f"replaced {path}, but failed to sync its directory"
            ) from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def load_jobs() -> list[dict]:
    if POWDER_JOBS.exists():
        return json.loads(POWDER_JOBS.read_text())
    return []


def save_jobs(jobs: list[dict]) -> None:
    content = json.dumps(jobs, indent=2, sort_keys=True) + "\n"
    atomic_write(POWDER_JOBS, content, 0o600)


def append_op(op: dict) -> None:
    with POWDER_OPS.open("a") as handle:
        handle.write(json.dumps(op, separators=(",", ":")) + "\n")


def emit(value) -> None:
    print(json.dumps(value, separators=(",", ":")))


def job_payload(job: dict) -> dict:
    payload = {key: value for key, value in job.items() if not key.startswith("_")}
    payload["derived"] = {"terminal": job.get("state") in {"done", "abandoned"}}
    return payload


def fail(code: str, message: str) -> None:
    print(json.dumps({"code": code, "error": message}, separators=(",", ":")), file=sys.stderr)

def option(args: list[str], *names: str) -> str | None:
    for index, arg in enumerate(args):
        if arg in names and index + 1 < len(args):
            return args[index + 1]
        for name in names:
            if arg.startswith(name + "="):
                return arg.split("=", 1)[1]
    return None


def positional_id(args: list[str]) -> str | None:
    if len(args) > 1 and not args[1].startswith("-"):
        return args[1]
    return None


def find_job(jobs: list[dict], job_id: str | None) -> dict | None:
    if job_id is None:
        return None
    return next((job for job in jobs if job["id"] == job_id), None)


def current_agent(args: list[str]) -> str:
    return option(args, "--agent") or os.environ.get("POWDER_AGENT") or EVAL_AGENT


def valid_job_id(job_id: object) -> bool:
    return isinstance(job_id, str) and JOB_ID.fullmatch(job_id) is not None


def claim_path(job_id: str) -> Path:
    if not valid_job_id(job_id):
        raise ValueError(f"invalid Powder job id {job_id!r}")
    state_root = Path(os.environ.get("XDG_STATE_HOME") or POWDER_JOBS.parent / "claim-state")
    claims_root = (state_root / "powder" / "claims" / "eval-origin").resolve()
    path = claims_root / job_id
    if path.parent != claims_root:
        raise ValueError(f"Powder claim path escapes its state root: {job_id!r}")
    return path


def stored_claim(job_id: str) -> str | None:
    path = claim_path(job_id)
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return None
    with os.fdopen(descriptor) as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) & 0o077:
            raise ValueError(f"Powder claim state is not a private regular file: {job_id!r}")
        return handle.read().strip()


def save_claim(job_id: str, token: str) -> None:
    path = claim_path(job_id)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    atomic_write(path, token, 0o600)


def delete_claim(job_id: str) -> None:
    claim_path(job_id).unlink(missing_ok=True)


def claim_matches(job: dict, token: str) -> bool:
    expected = job.get("_claim_hash")
    actual = hashlib.sha256(token.encode()).hexdigest()
    return isinstance(expected, str) and secrets.compare_digest(actual, expected)

def persist_new_claim(jobs: list[dict], job: dict, job_id: str, agent: str, token: str) -> None:
    save_claim(job_id, token)
    job["lease"] = {"agent": agent}
    job["_claim_hash"] = hashlib.sha256(token.encode()).hexdigest()
    try:
        save_jobs(jobs)
    except PostCommitSyncError:
        raise
    except Exception:
        try:
            delete_claim(job_id)
        finally:
            job["lease"] = None
            job.pop("_claim_hash", None)
        raise


def require_claim(job: dict) -> str | None:
    token = stored_claim(job["id"])
    if token is None:
        fail("claim_required", f"job {job['id']!r} requires its claim")
        return None
    if not claim_matches(job, token):
        fail("invalid_claim", f"job {job['id']!r} claim is invalid")
        return None
    return token

def missing(job_id: str | None) -> None:
    fail("not_found", f"job {job_id!r} not found")

def main() -> int:
    args = sys.argv[1:]
    if not args:
        return 0
    command = args[0]

    if command == "create":
        job_id = option(args, "--id")
        title = option(args, "--title")
        repo = option(args, "--repo")
        if not valid_job_id(job_id):
            fail("invalid_id", f"id {job_id!r} is not a slug")
            return 1
        spec = option(args, "--spec")
        jobs = load_jobs()
        existing = next((job for job in jobs if job["id"] == job_id), None)
        if existing is not None:
            emit(job_payload(existing))
            return 0
        job = {
            "id": job_id,
            "title": title,
            "repo": repo,
            "spec": spec or "",
            "state": "draft" if not spec else "open",
            "lease": None,
        }
        jobs.append(job)
        save_jobs(jobs)
        append_op({"op": "create", "id": job_id, "title": title, "repo": repo, "spec": spec or ""})
        emit(job_payload(job))
        return 0

    if command == "note":
        job_id = option(args, "--id") or positional_id(args)
        text = option(args, "--text")
        agent = option(args, "--agent")
        append_op({"op": "note", "id": job_id, "text": text, "agent": agent})
        emit({"id": job_id, "note": text})
        return 0

    if command == "list":
        jobs = load_jobs()
        repo = option(args, "--repo")
        if repo is not None:
            jobs = [job for job in jobs if job.get("repo") == repo]
        mine = option(args, "--mine")
        if mine is not None:
            jobs = [
                job
                for job in jobs
                if job.get("lease") is not None and job["lease"].get("agent") == mine
            ]
        if "--takeable" in args:
            jobs = [
                job
                for job in jobs
                if str(job.get("spec") or "").strip()
                and job.get("lease") is None
                and job.get("state") not in {"done", "abandoned"}
            ]
        emit([job_payload(job) for job in jobs])
        return 0

    if command == "show":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        append_op({"op": "show", "id": job_id})
        emit(job_payload(job))
        return 0

    if command == "take":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        if not valid_job_id(job_id):
            fail("invalid_id", f"id {job_id!r} is not a slug")
            return 1
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        agent = current_agent(args)
        if job.get("state") in {"done", "abandoned"}:
            fail("terminal", f"job {job_id!r} is terminal")
            return 1
        lease = job.get("lease")
        if lease is not None:
            token = stored_claim(job_id)
            if token is None or not claim_matches(job, token):
                fail("held", f"job {job_id!r} is held")
                return 1
        else:
            token = secrets.token_urlsafe(32)
            persist_new_claim(jobs, job, job_id, agent, token)
        append_op({"op": "take", "id": job_id, "agent": agent})
        emit(job_payload(job))
        return 0

    if command == "release":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        if not valid_job_id(job_id):
            fail("invalid_id", f"id {job_id!r} is not a slug")
            return 1
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        if require_claim(job) is None:
            return 1
        job["lease"] = None
        job.pop("_claim_hash", None)
        save_jobs(jobs)
        delete_claim(job_id)
        append_op({"op": "release", "id": job_id})
        emit(job_payload(job))
        return 0

    if command == "ask":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        if not valid_job_id(job_id):
            fail("invalid_id", f"id {job_id!r} is not a slug")
            return 1
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        if require_claim(job) is None:
            return 1
        question = option(args, "--question")
        job["lease"] = None
        job.pop("_claim_hash", None)
        save_jobs(jobs)
        delete_claim(job_id)
        append_op({"op": "ask", "id": job_id, "question": question or ""})
        emit(job_payload(job))
        return 0

    if command == "done":
        jobs = load_jobs()
        job_id = option(args, "--id") or positional_id(args)
        if not valid_job_id(job_id):
            fail("invalid_id", f"id {job_id!r} is not a slug")
            return 1
        job = find_job(jobs, job_id)
        if job is None:
            missing(job_id)
            return 1
        agent = current_agent(args)
        if require_claim(job) is None:
            return 1
        proof = option(args, "--proof")
        if not proof:
            fail("invalid_argument", "proof is required")
            return 2
        job["state"] = "done"
        job["proof"] = proof
        job["lease"] = None
        job.pop("_claim_hash", None)
        save_jobs(jobs)
        delete_claim(job_id)
        append_op({"op": "done", "id": job_id, "agent": agent, "proof": proof})
        emit(job_payload(job))
        return 0

    if command in {
        "renew", "answer", "abandon", "reopen",
        "set-title", "set-spec", "set-repo", "set-blockers",
        "version", "skill",
    }:
        print(f"powder fixture rejects forbidden command: {' '.join(args)}", file=sys.stderr)
        return 2

    print(f"unsupported powder fixture invocation: {' '.join(args)}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
