#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
from pathlib import Path
from urllib.parse import parse_qs, urlparse

from hidden import ISSUE_CREATED, PR_CREATED, SCENARIO


def emit(value) -> None:
    print(json.dumps(value, separators=(",", ":")))


def option(args: list[str], *names: str) -> str | None:
    for index, arg in enumerate(args):
        if arg in names and index + 1 < len(args):
            return args[index + 1]
        for name in names:
            if arg.startswith(name + "="):
                return arg.split("=", 1)[1]
    return None


def issue_labels(issue: dict) -> list[str]:
    labels = issue.get("labels")
    if isinstance(labels, list):
        result: list[str] = []
        for label in labels:
            if isinstance(label, dict):
                name = label.get("name")
                if isinstance(name, str) and name:
                    result.append(name)
            elif isinstance(label, str) and label:
                result.append(label)
        if result:
            return result
    return ["forest:ready"]


def issue_payload(issue: dict) -> dict:
    return {
        "number": issue["number"],
        "title": issue["title"],
        "body": issue["body"],
        "labels": [{"name": name} for name in issue_labels(issue)],
        "url": f"https://github.invalid/local/eval/issues/{issue['number']}",
    }


def issue_list(issue: dict | None, label: str | None) -> list[dict]:
    if issue is None:
        return []
    if label is not None and label not in issue_labels(issue):
        return []
    return [issue_payload(issue)]


def main() -> int:
    scenario = json.loads(SCENARIO.read_text())
    args = sys.argv[1:]
    issue = scenario.get("issue")
    if args[:2] == ["issue", "list"]:
        emit(issue_list(issue, option(args, "--label")))
        return 0
    if args[:2] == ["issue", "view"]:
        if issue is None:
            print("issue not found", file=sys.stderr)
            return 1
        emit({**issue_payload(issue), "state": "OPEN"})
        return 0
    if args and args[0] == "api":
        if any(arg in {"--help", "-h"} for arg in args[1:]):
            print("unsupported gh fixture invocation: " + " ".join(args), file=sys.stderr)
            return 2
        endpoint = args[-1]
        query = parse_qs(urlparse(endpoint).query)
        label = query.get("labels", [None])[0]
        emit([issue_list(issue, label)])
        return 0
    if args[:2] == ["pr", "list"]:
        emit([])
        return 0
    if args[:2] == ["pr", "create"]:
        if any(arg in {"--help", "-h"} for arg in args[2:]):
            print("unsupported gh fixture invocation: " + " ".join(args), file=sys.stderr)
            return 2
        record = {
            "head": option(args, "--head"),
            "base": option(args, "--base") or "master",
            "title": option(args, "--title"),
            "body": option(args, "--body"),
        }
        PR_CREATED.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
        print("https://github.invalid/local/eval/pull/1")
        return 0
    if args[:2] == ["issue", "create"]:
        if any(arg in {"--help", "-h"} for arg in args[2:]):
            print("unsupported gh fixture invocation: " + " ".join(args), file=sys.stderr)
            return 2
        ISSUE_CREATED.write_text(json.dumps({"args": args[2:]}, indent=2) + "\n")
        print("https://github.invalid/local/eval/issues/999")
        return 0
    if args[:2] == ["repo", "view"]:
        emit({"nameWithOwner": "local/eval", "defaultBranchRef": {"name": "master"}})
        return 0
    if args and args[0] == "auth":
        return 0
    print(f"unsupported gh fixture invocation: {' '.join(args)}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
